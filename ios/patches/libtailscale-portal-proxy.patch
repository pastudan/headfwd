index 34a6f94..1267317 100644
--- a/swift/TailscaleKit/TailscaleNode.swift
+++ b/swift/TailscaleKit/TailscaleNode.swift
@@ -204,6 +204,37 @@ public actor TailscaleNode {
 
     private var loopbackConfig: LoopbackConfig?
 
+    // MARK: - Portal proxy
+
+    /// Starts a local HTTP reverse proxy on 127.0.0.1 that forwards all
+    /// requests to targetAddr (host:port) over the tsnet WireGuard tunnel.
+    ///
+    /// Returns the assigned port.  Load `http://127.0.0.1:<port>/` in
+    /// WKWebView to get a proper http:// origin:
+    ///   - ES modules execute (no custom-scheme restrictions)
+    ///   - WebSocket upgrades work (Vite HMR, real-time events)
+    ///   - ATS does not apply (localhost is always ATS-exempt)
+    ///   - All fetch('/api/…') calls hit 127.0.0.1 → same origin → no CORS
+    ///
+    /// If a proxy is already running for this node it is replaced.
+    public func startPortalProxy(targetAddr: String) throws -> Int {
+        guard let tailscale else {
+            throw TailscaleError.badInterfaceHandle
+        }
+        var port: Int32 = 0
+        let res = tailscale_start_portal_proxy(tailscale, targetAddr, &port)
+        guard res == 0 else {
+            throw TailscaleError.fromPosixErrCode(res, tailscale.getErrorMessage())
+        }
+        return Int(port)
+    }
+
+    /// Shuts down the local portal proxy. Safe to call if no proxy is running.
+    public func stopPortalProxy() {
+        guard let tailscale else { return }
+        tailscale_stop_portal_proxy(tailscale)
+    }
+
     /// Starts and returns the address and credentials of a SOCKS5 proxy which can also
     /// be used to query the localAPI
     public func loopback() throws -> LoopbackConfig {

diff --git a/tailscale_portal_proxy.go b/tailscale_portal_proxy.go
new file mode 100644
index 0000000..c17aacd
--- /dev/null
+++ b/tailscale_portal_proxy.go
@@ -0,0 +1,120 @@
+// Copyright (c) HeadFwd Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Local HTTP portal proxy for WKWebView.
+//
+// WKWebView runs in a sandboxed WebContent process that cannot use
+// URLSessionConfiguration proxy settings. The previous tsnet:// custom-scheme
+// workaround worked for data but WKWebView refuses to execute ES-module scripts
+// from custom schemes, and WebSocket upgrades (Vite HMR) are silently dropped.
+//
+// This file starts a standard HTTP reverse proxy bound to 127.0.0.1 that
+// forwards every request to the tailnet portal over the WireGuard tunnel,
+// using tsnet.Server.Dial as the TCP dialer. WKWebView loads
+// http://127.0.0.1:<port>/ — a proper http:// origin:
+//
+//   - ES modules execute (http:// is treated as a secure-enough context).
+//   - WebSocket upgrades (ws://127.0.0.1:<port>/...) are forwarded — Vite HMR fires.
+//   - ATS does not apply (localhost is always ATS-exempt; no NSAllowsArbitraryLoads needed).
+//   - All JS fetch('/api/…') calls hit 127.0.0.1 → same origin → no CORS headers required.
+
+package main
+
+/*
+#include "errno.h"
+*/
+import "C"
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httputil"
+	"net/url"
+	"sync"
+)
+
+// portalProxies stores the running portal proxy server for each tsnet server
+// descriptor so we can stop it cleanly on demand or restart it.
+var portalProxies struct {
+	mu sync.Mutex
+	m  map[C.int]*http.Server
+}
+
+//export TsnetStartPortalProxy
+// TsnetStartPortalProxy starts a local HTTP reverse proxy on 127.0.0.1 that
+// forwards all requests to targetAddr via the tsnet WireGuard tunnel.
+// The assigned TCP port is written to portOut on success.
+//
+// targetAddr must be host:port, e.g. "100.64.0.5:3001".
+//
+// Returns zero on success or -1 on error; call tailscale_errmsg for details.
+// If a proxy is already running for this server it is stopped first.
+func TsnetStartPortalProxy(sd C.int, targetAddr *C.char, portOut *C.int) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+
+	goTarget := C.GoString(targetAddr)
+	target, err := url.Parse("http://" + goTarget)
+	if err != nil {
+		return s.recErr(fmt.Errorf("portal proxy: parse target %q: %w", goTarget, err))
+	}
+
+	proxy := httputil.NewSingleHostReverseProxy(target)
+	// Wire the proxy's outgoing dialer through the WireGuard tunnel so all
+	// TCP connections to the tailnet portal use tsnet — not the host network.
+	proxy.Transport = &http.Transport{
+		DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			return s.s.Dial(ctx, network, addr)
+		},
+	}
+	// Preserve the Host header so the portal's mux and any upstream proxy
+	// rules route correctly (they match on the Host header).
+	origDirector := proxy.Director
+	proxy.Director = func(req *http.Request) {
+		origDirector(req)
+		req.Host = target.Host
+	}
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return s.recErr(fmt.Errorf("portal proxy: listen: %w", err))
+	}
+
+	srv := &http.Server{Handler: proxy}
+
+	portalProxies.mu.Lock()
+	if portalProxies.m == nil {
+		portalProxies.m = make(map[C.int]*http.Server)
+	}
+	if existing, ok := portalProxies.m[sd]; ok {
+		existing.Close()
+	}
+	portalProxies.m[sd] = srv
+	portalProxies.mu.Unlock()
+
+	go srv.Serve(ln) //nolint:errcheck
+
+	*portOut = C.int(ln.Addr().(*net.TCPAddr).Port)
+	return 0
+}
+
+//export TsnetStopPortalProxy
+// TsnetStopPortalProxy shuts down the local portal proxy for the given server.
+// It is safe to call when no proxy is running.
+func TsnetStopPortalProxy(sd C.int) C.int {
+	portalProxies.mu.Lock()
+	srv, ok := portalProxies.m[sd]
+	if ok {
+		delete(portalProxies.m, sd)
+	}
+	portalProxies.mu.Unlock()
+
+	if srv != nil {
+		srv.Close()
+	}
+	return 0
+}
